# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" NUNCA deve subir para o git (está no .gitignore).
# Este ".env.example" sobe para o git como modelo para quem clonar o projeto.

# Porta em que a API vai rodar
PORT=3000

# Conexão com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=drip_store
DB_USER=root
DB_PASSWORD=sua_senha_aqui

# Segredo usado para assinar os tokens JWT (invente uma string longa e aleatória)
JWT_SECRET=troque_por_uma_string_secreta_longa

# Tempo de validade do token (ex: 1h, 7d)
JWT_EXPIRES_IN=1d
